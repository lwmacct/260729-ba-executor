{
  "name": "@lwmacct/260729-ba-executor",
  "version": "0.6.260730",
  "description": "Generic HTTP and CLI executor host for composable Baton Step Packs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwmacct/260729-ba-executor.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ba-executor": "./dist/main.js"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run build",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@lwmacct/260729-ba-context-baton": "^0.5.260729",
    "@lwmacct/260729-ba-framework": "^0.5.260729",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
